<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Панели x-ui часто работают по HTTP в локальной сети или VPN,
         поэтому cleartext-трафик разрешён. Доверенные CA — системные. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
